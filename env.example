# Copy to .env.test for `pnpm test:live` (the unit tests never need it).
# The live test posts as you (visible to your connections only), edits the post and deletes it.
LINKEDIN_LIVE=1
# Uses the sign-in `linkedin mcp config --web` saved, unless a token is given here:
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=urn:li:person:...
# LINKEDIN_API_VERSION=202609
