{
  "name": "@hoyasumii/linkedin",
  "version": "0.1.0",
  "description": "Unofficial LinkedIn SDK and MCP server to create, edit and delete your own posts, with a CLI that logs in and installs the server",
  "author": "Alan Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoyasumii/linkedin.git"
  },
  "homepage": "https://hoyasumii.github.io/linkedin/",
  "bugs": {
    "url": "https://github.com/Hoyasumii/linkedin/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp/index.d.ts"
      ]
    }
  },
  "bin": {
    "linkedin-mcp": "dist/mcp/cli.js",
    "linkedin": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:live": "jest --testPathPattern=tests/live",
    "test:watch": "jest --watch",
    "clean": "node -e \"for (const dir of ['dist', 'node_modules']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "check:types": "tsc --noEmit -p tsconfig.jest.json",
    "check:lint": "oxlint",
    "fix:lint": "oxlint --fix",
    "check:format": "oxfmt --check",
    "fix:format": "oxfmt",
    "codegen": "orval --config orval.config.ts && oxfmt src/generated",
    "docs:dev": "pnpm --filter @hoyasumii/linkedin-website start",
    "docs:build": "pnpm --filter @hoyasumii/linkedin-website build",
    "docs:serve": "pnpm --filter @hoyasumii/linkedin-website serve",
    "docs:deploy": "pnpm --filter @hoyasumii/linkedin-website run deploy",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "check:knip": "knip",
    "fix:knip": "knip --fix"
  },
  "keywords": [
    "linkedin",
    "linkedin-api",
    "posts",
    "social",
    "sdk",
    "mcp",
    "model-context-protocol",
    "typescript",
    "node"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "citty": "^0.1.6",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "knip": "^6.38.0",
    "orval": "^8.39.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
